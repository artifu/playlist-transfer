[Unit]
Description=PlaylistXfer transfer API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=playlistxfer
Group=playlistxfer
WorkingDirectory=/opt/playlistxfer
Environment=NODE_ENV=production
Environment=TRANSFER_API_HOST=127.0.0.1
Environment=TRANSFER_API_PORT=8791
Environment=TRANSFER_API_STORAGE_DRIVER=sqlite
Environment=TRANSFER_API_DB_PATH=/opt/playlistxfer/data/playlistxfer.sqlite
Environment=TRANSFER_API_TRANSFER_RETENTION_DAYS=7
Environment=TRANSFER_API_CLEANUP_INTERVAL_MS=3600000
Environment=TRANSFER_API_RATE_LIMIT_WINDOW_MS=60000
Environment=TRANSFER_API_RATE_LIMIT_MAX=240
ExecStart=/usr/local/bin/node --disable-warning=ExperimentalWarning apps/transfer-api/server.mjs
Restart=always
RestartSec=3
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/playlistxfer/data
MemoryMax=384M

[Install]
WantedBy=multi-user.target
